# CentralObra - Environment Configuration

# 1. Autenticação e Banco de Dados
VITE_FIREBASE_API_KEY="SUA_CHAVE_AQUI"
VITE_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="seu-projeto"
VITE_FIREBASE_STORAGE_BUCKET="seu-projeto.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="0000000000"
VITE_FIREBASE_APP_ID="1:0000000000:web:abcdef123456"

# 2. IA / Copilot
VITE_GEMINI_KEY="" # Chave da API do Google Gemini (usado no SmartAssistant)

# 3. Clima (Meteorologia)
VITE_WEATHER_KEY="" # Chave da API do OpenWeatherMap ou WeatherAPI

# 4. Mapas e Geocodificação
VITE_GOOGLE_MAPS_KEY="" # Chave do Google Maps Platform (Places, Directions, Geocoding)

# 5. Índices e Automações Financeiras (Futuro)
VITE_BACEN_API_TOKEN="" # Chave do BACEN para consultas econômicas se necessário
